00000400                                    25  *-----------------------------------Aquí empiezan etiquetas para trabajar más claramente con la DUART-----------------------------------*
00000400                                    26  
00000400                                    27  *----Línea A----*
00000400                                    28  
00000400  =00EFFC01                         29  MR1A EQU $effc01 *De modo A (primer acceso) A través de este registro se le ordena a la DUART el número de bits por caracter de la 
00000400                                    30              *línea correspondiente y cuando ha de solicitar una interrupción en recepción.
00000400  =00EFFC01                         31  MR2A EQU $effc01 *De modo A (posteriores accesos, tanto lectura como escritura) Modo de operación (Normal o Eco) 
00000400  =00EFFC03                         32  SRA EQU $effc03 *(En lectura) Registro de estado, consultar manual.
00000400  =00EFFC03                         33  CSRA EQU $effc03 *(En escritura)
00000400  =00EFFC05                         34  CRA EQU $effc05 *(Sólo escritura)
00000400  =00EFFC07                         35  RBA EQU $effc07 *(En lectura)
00000400  =00EFFC07                         36  TBA EQU $effc07 *(En escritura)
00000400                                    37  
00000400                                    38  *----Línea B----*
00000400                                    39  
00000400  =00EFFC11                         40  MR1B EQU $effc11 *(En lectura y escritura)
00000400  =00EFFC11                         41  MR2B EQU $effc11 *(En lectura y escritura)
00000400  =00EFFC13                         42  SRB EQU $effc13 *(En lectura)
00000400  =00EFFC13                         43  CSRB EQU $effc13 *(En escritura)
00000400  =00EFFC15                         44  CRB EQU $effc15 *(En escritura)
00000400  =00EFFC17                         45  RBB EQU $effc17 *(En lectura)
00000400  =00EFFC17                         46  TBB EQU $effc17 *(En escritura)
00000400                                    47  
00000400                                    48  *----Ambas líneas----*
00000400                                    49  
00000400  =00EFFC08                         50  ACR EQU $effc08 *(En escritura)
00000400  =00EFFC0B                         51  ISR EQU $effc0b *(En lectura)
00000400  =00EFFC0B                         52  IMR EQU $effc0b *(En escritura)
00000400  =00EFFC19                         53  IVR EQU $effc19 *(En lectura y escritura)
00000400                                    54  
