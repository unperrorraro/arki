00000416  13FC 0003 00EFFC01                64         MOVE.B #%00000011,MR1A *Línea A 8 bits por caracter, RxRDY
0000041E  13FC 0000 00EFFC01                65         MOVE.B #$0,MR2A        *Modo Normal en A
